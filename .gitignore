__pycache__/
*.pyc
*.rbxl
*.rbxlx
.env

# Rojo output. The directory itself is kept so `rojo build -o <game>/build/...`
# works on a fresh clone; rojo does not create its output directory.
games/*/build/*
!games/*/build/.gitkeep

# Scratch folder for generated images and exports, not part of the build.
Claude outputs/
