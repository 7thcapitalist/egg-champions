            "CFrame": {
              "position": [0, -10, 0],
              "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
            }
          },
          "Material": "Grass",
          "Color": [0.42, 0.6, 0.31],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      },

      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "CFrame": {
            "CFrame": {
              "position": [0, 0.5, 0],
              "orientation": [[1, 0, 0], [0, 1, 0], [0, 0, 1]]
            }
          },
          "Material": "Concrete",
          "Color": [0.64, 0.64, 0.64],
          "TopSurface": "Smooth",
          "BottomSurface": "Smooth"
        }
      }
    },

    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.27, 0.27, 0.3],
        "OutdoorAmbient": [0.4, 0.4, 0.43],
        "Brightness": 2
      }
    }
